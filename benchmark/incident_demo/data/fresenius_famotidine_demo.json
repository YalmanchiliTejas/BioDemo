  "public_facts": [
    {
      "id": "PF-001",
      "statement": "FDA reported that famotidine injection manufacturing experienced multiple bioburden action-limit failures.",
      "source": "FDA warning letter"
    },
    {
      "id": "PF-002",
      "statement": "The firm's response acknowledged gram-negative confluent growth in bioburden samples.",
      "source": "FDA warning letter"
    },
    {
      "id": "PF-003",
      "statement": "FDA reported that affected batches were released following passing finished-product sterility and endotoxin tests.",
      "source": "FDA warning letter"
    },
    {
      "id": "PF-004",
      "statement": "Subsequent finished-product retain testing identified an endotoxin failure.",
      "source": "FDA warning letter"
    },
    {
      "id": "PF-005",
      "statement": "Lots 6133156, 6133194, and 6133388 were recalled.",
      "source": "FDA-posted recall announcement"
    },
    {
      "id": "PF-006",
      "statement": "FDA criticized investigation scope, data-supported root-cause evaluation, reliance on passing finished-product tests, and CAPA effectiveness checks.",
      "source": "FDA warning letter"
    }
  ],
