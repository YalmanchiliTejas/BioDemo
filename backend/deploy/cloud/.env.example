# Public configuration only. Put credentials in ./secrets (never in git).
CONTROL_IMAGE=registry.digitalocean.com/your-registry/control@sha256:REPLACE
AGENT_IMAGE=registry.digitalocean.com/your-registry/agent@sha256:REPLACE
CADDY_IMAGE=caddy@sha256:REPLACE
POSTGRES_IMAGE=postgres@sha256:REPLACE
SQUID_IMAGE=ubuntu/squid@sha256:REPLACE
API_DOMAIN=api.example.com
DEPLOYMENT_TENANT=pilot-customer
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
ARTIFACT_BUCKET=biodemo-private
BACKUP_BUCKET=biodemo-private-backups
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=biodemo-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
BIODEMO_PRIME_MODEL=approved-provider/approved-model
MODEL_SECRET_ENV=APPROVED_PROVIDER_API_KEY
