# Copy to production.env (git-ignored) and fill in. Read by deploy.sh only.
AWS_REGION=us-west-2
# STACK_NAME=biodemo-api
# FUNCTION_NAME=biodemo-api
# ECR_REPOSITORY=biodemo-api

# Supabase: runtime login lifesci_app on the session pooler (never the postgres login).
DATABASE_URL=postgresql://lifesci_app.<project-ref>:<app password>@<pooler-host>:5432/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
# Used by the backend only for the private Storage bucket of original files.
SUPABASE_SERVICE_ROLE_KEY=
CMO_STORAGE_BUCKET=cmo-evidence
# Only for Supabase projects still on the legacy shared JWT secret:
# SUPABASE_JWT_SECRET=

# Legacy customer preserved for existing accounts and scheduled work.
# New accounts create isolated organizations when multi-tenancy is enabled.
LIFESCI_MULTI_TENANT=1
DEPLOYMENT_TENANT=sievance
# Frontend origin(s), comma-separated, no trailing slash.
CORS_ORIGINS=https://www.sievance.com,https://sievance.com,https://app.sievance.com

# Assistant model on Modal (OpenAI-compatible chat completions).
MODAL_BASE_URL=https://<workspace>--<app>.modal.direct/v1
MODAL_PROXY_TOKEN=
LIFESCI_LLM_MODEL=zai-org/GLM-5.3
# 1 = usable before a recorded evaluation qualifies the model; answers are flagged for review.
LIFESCI_ALLOW_UNQUALIFIED_ROUTES=1

# Encrypts credentials entered for guided data connections: openssl rand -base64 32
# Keep a copy somewhere safe; changing or losing it makes saved credentials unreadable.
LIFESCI_CONNECTOR_KEY=

# Multi-agent investigations run on the executor (backend/src/cloud_backend, DigitalOcean pilot).
# Leave INVESTIGATION_EXECUTOR_URL empty to keep them off; the UI then says "not configured".
# Signing key: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out key.pem, then
#   aws secretsmanager create-secret --name biodemo/investigation-signing-key --secret-string file://key.pem
# and put the returned ARN below (the PEM itself would not fit Lambda's 4 KB environment).
# Configure the executor's verifier with OIDC_ISSUER=<INVESTIGATION_ISSUER>,
# OIDC_JWKS_URL=<INVESTIGATION_ISSUER>/.well-known/investigation-jwks.json, OIDC_AUDIENCE=<audience>,
# DEPLOYMENT_TENANT=<INVESTIGATION_EXECUTOR_TENANT>.
INVESTIGATION_EXECUTOR_URL=
INVESTIGATION_EXECUTOR_AUDIENCE=
INVESTIGATION_EXECUTOR_TENANT=
# Empty: one executor project per platform organization.
INVESTIGATION_EXECUTOR_PROJECT=
INVESTIGATION_ISSUER=https://api.sievance.com
INVESTIGATION_SIGNING_KEY_SECRET_ARN=
INVESTIGATION_SIGNING_KEY_ID=investigation-1

# RUNTIME_SCHEDULE=rate(1 minute)
# MEMORY_SIZE=3008

# Custom API hostname behind CloudFront. Get CERTIFICATE_ARN from deploy/aws/request-certificate.sh.
API_DOMAIN=api.sievance.com
CERTIFICATE_ARN=

# 0 omits Lambda reserved concurrency so low-quota accounts can deploy.
# Set 1-5 only after confirming sufficient account quota and database headroom.
RESERVED_CONCURRENCY=0

# Multi-agent investigations are a paid feature: comma-separated organization (tenant) ids that have it. Empty = nobody.
INVESTIGATIONS_ENABLED_TENANTS=
