# Clairic extraction + OpenAI Decisions classification/mapping.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
CMO_DECISIONS_URL=https://api.openai.com/v1/decisions
CMO_DECISIONS_MIN_CONFIDENCE=0.95
# Input-only estimate; adjust for your account/region.
CMO_DECISIONS_INPUT_USD_PER_MILLION=0.10
# Comma separated origins (scheme://host:port), without paths.
CMO_ALLOWED_ORIGINS=https://api.openai.com,https://api.cloudflare.com,http://localhost:8001,http://127.0.0.1:8001
# Provision Docling model assets before using Decisions.
DOCLING_ARTIFACTS_PATH=
CMO_API_TOKEN=

# Native Cloudflare Workers AI Clairic. Fill these two values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
# Optional cost estimate; input tokens only.
CMO_CLAIRIC_INPUT_USD_PER_MILLION=0.10
