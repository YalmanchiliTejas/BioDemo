# Local demonstration only. Use URL-safe random passwords for interpolated URLs.
POSTGRES_PASSWORD=replace-with-owner-password
LIFESCI_APP_PASSWORD=replace-with-separate-runtime-password
LIFESCI_TENANTS=demo-northfield
# Enable these only together with compose --profile media. LiveKit --dev defaults:
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_URL=http://media:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Pin approved image digests for a shared environment. Temporal start-dev and
# LiveKit --dev are local demonstration processes, not production deployments.
