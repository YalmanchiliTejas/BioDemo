# Copy the relevant settings into backend/.env.local, preserving existing values.
# Choose anthropic or openai, and the exact model ID available to your API account.
LIFESCI_LLM_PROVIDER=anthropic
LIFESCI_LLM_MODEL=YOUR_EXACT_API_MODEL_ID
ANTHROPIC_API_KEY=YOUR_API_KEY
# For OpenAI instead: LIFESCI_LLM_PROVIDER=openai and OPENAI_API_KEY=YOUR_API_KEY
# For a Modal-hosted OpenAI-compatible Chat Completions deployment instead:
# LIFESCI_LLM_PROVIDER=modal
# LIFESCI_LLM_MODEL=zai-org/GLM-5.3
# MODAL_BASE_URL=https://YOUR_WORKSPACE--YOUR_APP.modal.direct/v1
# MODAL_PROXY_TOKEN=wk-YOUR_ID.ws-YOUR_SECRET   (BIODEMO_MODAL_* names also accepted)
# MODAL_TIMEOUT_SECONDS=300        # reasoning models are slow
# MODAL_MIN_MAX_TOKENS=16000       # reasoning + answer budget floor
# Modal per-token prices default to 0 (self-hosted); set LIFESCI_LLM_*_USD_PER_MTOK to estimate compute.

# Development testing only: no passing route evaluation is fabricated.
LIFESCI_ALLOW_UNQUALIFIED_ROUTES=1

# Optional: use another model/provider to interpret computed results.
# Otherwise both roles use LIFESCI_LLM_MODEL and LIFESCI_LLM_PROVIDER.
# LIFESCI_INTERPRETER_MODEL=YOUR_OTHER_MODEL_ID
# LIFESCI_INTERPRETER_PROVIDER=openai
# OPENAI_API_KEY=YOUR_OTHER_PROVIDER_KEY

# Optional custom API server; these adapters use Responses or Messages, not Chat Completions.
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# ANTHROPIC_BASE_URL=https://YOUR_MESSAGES_API_SERVER

# Optional known pricing estimates, USD per million tokens.
# Without these, route metadata labels the 10/50/10 rates as development
# budgeting assumptions, NOT provider prices or an actual invoice.
# LIFESCI_LLM_INPUT_USD_PER_MTOK=...
# LIFESCI_LLM_OUTPUT_USD_PER_MTOK=...
# LIFESCI_LLM_CACHED_INPUT_USD_PER_MTOK=...
# A separately overridden interpreter uses LIFESCI_INTERPRETER_*_USD_PER_MTOK.
