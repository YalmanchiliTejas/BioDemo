# Copy the relevant settings into backend/.env.local, preserving existing values.
# Choose anthropic or openai, and the exact model ID available to your API account.
LIFESCI_LLM_PROVIDER=anthropic
LIFESCI_LLM_MODEL=YOUR_EXACT_API_MODEL_ID
ANTHROPIC_API_KEY=YOUR_API_KEY
# For OpenAI instead: LIFESCI_LLM_PROVIDER=openai and OPENAI_API_KEY=YOUR_API_KEY
# For a Modal-hosted OpenAI-compatible Chat Completions deployment instead:
# LIFESCI_LLM_PROVIDER=modal
# LIFESCI_LLM_MODEL=zai-org/GLM-5.3
# MODAL_BASE_URL=https://YOUR_WORKSPACE--YOUR_APP.modal.direct/v1
# MODAL_PROXY_TOKEN=wk-YOUR_ID.ws-YOUR_SECRET   (BIODEMO_MODAL_* names also accepted)
# MODAL_TIMEOUT_SECONDS=300        # reasoning models are slow
# MODAL_MIN_MAX_TOKENS=16000       # reasoning + answer budget floor
# Modal per-token prices default to 0 (self-hosted); set LIFESCI_LLM_*_USD_PER_MTOK to estimate compute.

# Development testing only: no passing route evaluation is fabricated.
LIFESCI_ALLOW_UNQUALIFIED_ROUTES=1

# Optional: use another model/provider to interpret computed results.
# Otherwise both roles use LIFESCI_LLM_MODEL and LIFESCI_LLM_PROVIDER.
# LIFESCI_INTERPRETER_MODEL=YOUR_OTHER_MODEL_ID
# LIFESCI_INTERPRETER_PROVIDER=openai
# OPENAI_API_KEY=YOUR_OTHER_PROVIDER_KEY

# Optional custom API server; these adapters use Responses or Messages, not Chat Completions.
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# ANTHROPIC_BASE_URL=https://YOUR_MESSAGES_API_SERVER

# Optional known pricing estimates, USD per million tokens.
# Without these, route metadata labels the 10/50/10 rates as development
# budgeting assumptions, NOT provider prices or an actual invoice.
# LIFESCI_LLM_INPUT_USD_PER_MTOK=...
# LIFESCI_LLM_OUTPUT_USD_PER_MTOK=...
# LIFESCI_LLM_CACHED_INPUT_USD_PER_MTOK=...
# A separately overridden interpreter uses LIFESCI_INTERPRETER_*_USD_PER_MTOK.

# Optional decision model (trial option C). Off unless both lines below are set.
# Jev answers closed questions about evidence a person can already read: which recorded
# parameter a name means, which task a typed request names, how relevant a found record is.
# It never retrieves, grants access, calculates or writes. With it off, or on any timeout or
# invalid answer, the host rules run unchanged.
# Evidence text is sent to TypeSafe's API. Review their data terms before using customer data.
# LIFESCI_DECISION_ADAPTER=jev
# TYPESAFE_API_KEY=YOUR_TYPESAFE_KEY
# LIFESCI_DECISION_MODEL=jev-1.14.0        # pinned: a calibration applies to one model version
# LIFESCI_DECISION_TIMEOUT_S=2             # past this, the request continues without the model
# A selection is applied automatically only for a task listed in this file, written by
#   python -m benchmarks.workflow_trial.run --write-calibration <path>
# from held-out requests. Without it every answer is a suggestion a person confirms.
# LIFESCI_DECISION_CALIBRATION=/absolute/path/to/decision-calibration.json
# LIFESCI_DECISION_INPUT_USD_PER_MTOK=0.042   # published input price on 2026-11-14; an estimate

# Answer-time target in seconds. Measured and shown, never enforced: slower answers are still delivered.
# LIFESCI_ANSWER_TARGET_S=10
# Routine typed requests in chat are calculated directly; set to off to send every message to the assistant.
# ASSISTANT_DIRECT_ROUTE=on

# The one-call explanation of a calculated result ("Explain" in the workbench) can run at its own reasoning
# effort on a Modal deployment, leaving the open-ended assistant at the deployment's default.
# Measured on host-calculated comparisons in backend/results/workflow-trial-live-*. Unset: no change.
# LIFESCI_INTERPRETER_REASONING_EFFORT=low
# LIFESCI_EXPLANATION_TIMEOUT_S=60

# A "why" question in chat that names one delivery and one recorded parameter is answered first by the one-call
# explanation of the host's calculation; a follow-up goes to the assistant. Set to off to send it straight there.
# ASSISTANT_QUICK_ANSWERS=on
