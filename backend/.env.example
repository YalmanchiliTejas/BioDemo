# Use `codex` for an existing Codex login or `openai` for the Responses API.
BIODEMO_RLM_PROVIDER=openai
BIODEMO_RLM_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Prime SDK model selection and project-owned Modal authentication.
BIODEMO_PRIME_MODEL=modal/zai-org/GLM-5.3
# Full Modal proxy token, without the Bearer prefix. Never commit a real token.
BIODEMO_MODAL_PROXY_TOKEN=
# Optional endpoint override; otherwise use the registered Modal provider URL.
BIODEMO_MODAL_BASE_URL=
