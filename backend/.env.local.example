# Life-sciences platform local configuration.
# Copy this file to .env.local and fill in real values. .env.local is git-ignored.
# `python -m src.lifesci ...` loads backend/.env.local automatically.
# Real environment variables take precedence over values in the file.

# --- Local PostgreSQL (recommended) -----------------------------------------
# Create the database once, then fill in both URLs and run db-migrate:
#   createdb biodemo_lifesci
#   python -m src.lifesci db-migrate
#
# The migration URL is the schema owner and is used only by db-migrate. The
# runtime URL uses a non-owner role, so row-level security applies to the app.
# Keep LIFESCI_DB_MIGRATE=0 so the app never attempts DDL as the runtime role.
#
# LIFESCI_MIGRATION_DATABASE_URL=postgresql://<your-user>@127.0.0.1:5432/biodemo_lifesci
# LIFESCI_DATABASE_URL=postgresql://lifesci_app:<app-password>@127.0.0.1:5432/biodemo_lifesci
# LIFESCI_APP_ROLE=lifesci_app
# LIFESCI_DB_MIGRATE=0

# CMO delivery verification records share this database (decision D52);
# CMO_DATABASE_URL is only needed to keep them elsewhere. Records saved in the
# old cmo.sqlite layout are copied once with:
#   python -m src.lifesci cmo-import-legacy .cache/cmo-ingestion/cmo.sqlite --tenant demo-northfield

# --- Local SQLite (alternative) --------------------------------------------
# LIFESCI_DATABASE_URL=sqlite:///.cache/lifesci-dev.db

# --- Authentication ---------------------------------------------------------
# LIFESCI_AUTH_MODE: supabase | oidc | development. Default: oidc when OIDC_ISSUER
# is set, otherwise development (X-Tenant-Id/X-Actor-Id headers; local only and
# refused on AWS Lambda). Tokens never carry roles: grant them with
#   python -m src.lifesci grant-role --email person@example.com --role qa
# LIFESCI_AUTH_MODE=supabase
# DEPLOYMENT_TENANT=your-tenant           # required for supabase and oidc modes
# SUPABASE_URL=https://<project-ref>.supabase.co
# Only for legacy projects still signing with the shared HS256 secret:
# SUPABASE_JWT_SECRET=
# Used only by grant-role/revoke-role --email; never deploy it to the API:
# SUPABASE_SERVICE_ROLE_KEY=
# Required outside development (comma-separated browser origins):
# LIFESCI_CORS_ORIGINS=https://your-app.vercel.app

# --- Optional ---------------------------------------------------------------
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=default
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Modal-hosted Chat Completions (LIFESCI_LLM_PROVIDER=modal); base URL includes /v1.
# MODAL_BASE_URL=
# MODAL_PROXY_TOKEN=
# MODAL_TIMEOUT_SECONDS=300
# MODAL_MIN_MAX_TOKENS=16000
# OIDC_ISSUER=
# LIFESCI_ALLOW_UNQUALIFIED_ROUTES=1

# Recover tenant-scoped missions/connector cursors after a process restart.
# LIFESCI_TENANTS=your-tenant
# Hosts must be explicitly allowed before network connectors can contact them.
# LIFESCI_CONNECTOR_ALLOWED_HOSTS=mes.example.com,lims.example.com
# LIFESCI_CONNECTOR_FILE_ROOT=/approved/exports
# LIMS_READ_TOKEN=
# OPCUA_SECURITY=Basic256Sha256,SignAndEncrypt,/certs/client.der,/certs/client.pem,/certs/server.der

# Live media (configure all three together; browser capture starts only on input).
# LIVEKIT_URL=wss://media.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_API_URL=https://media-internal.example.com
# Site gateway shared value: choose a variable name and provision it at both ends.
# BIODEMO_EDGE_SHARED_SECRET=
