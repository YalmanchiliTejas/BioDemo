# Life-sciences platform local configuration.
# Copy this file to .env.local and fill in real values. .env.local is git-ignored.
# `python -m src.lifesci ...` loads backend/.env.local automatically.
# Real environment variables take precedence over values in the file.

# --- Local PostgreSQL (recommended) -----------------------------------------
# Create the database once, then fill in both URLs and run db-migrate:
#   createdb biodemo_lifesci
#   python -m src.lifesci db-migrate
#
# The migration URL is the schema owner and is used only by db-migrate. The
# runtime URL uses a non-owner role, so row-level security applies to the app.
# Keep LIFESCI_DB_MIGRATE=0 so the app never attempts DDL as the runtime role.
#
# LIFESCI_MIGRATION_DATABASE_URL=postgresql://<your-user>@127.0.0.1:5432/biodemo_lifesci
# LIFESCI_DATABASE_URL=postgresql://lifesci_app:<app-password>@127.0.0.1:5432/biodemo_lifesci
# LIFESCI_APP_ROLE=lifesci_app
# LIFESCI_DB_MIGRATE=0

# --- Local SQLite (alternative) --------------------------------------------
# LIFESCI_DATABASE_URL=sqlite:///.cache/lifesci-dev.db

# --- Optional ---------------------------------------------------------------
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=default
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OIDC_ISSUER=
# LIFESCI_ALLOW_UNQUALIFIED_ROUTES=1

# Recover tenant-scoped missions/connector cursors after a process restart.
# LIFESCI_TENANTS=your-tenant
# Hosts must be explicitly allowed before network connectors can contact them.
# LIFESCI_CONNECTOR_ALLOWED_HOSTS=mes.example.com,lims.example.com
# LIFESCI_CONNECTOR_FILE_ROOT=/approved/exports
# LIMS_READ_TOKEN=
# OPCUA_SECURITY=Basic256Sha256,SignAndEncrypt,/certs/client.der,/certs/client.pem,/certs/server.der
