# Optional remote trace export; leave unset to retain local observations only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Real application inference. Or pass --provider-env /path/to/provider.env.
LIFESCI_LLM_PROVIDER=modal
LIFESCI_LLM_MODEL=zai-org/GLM-5.3
MODAL_BASE_URL=
MODAL_PROXY_TOKEN=
# Optional DeepEval judge/simulator. Never required for deterministic gates.
OPENAI_API_KEY=
SIEVANCE_EVAL_JUDGE_MODEL=
DEEPEVAL_TELEMETRY_OPT_OUT=YES
