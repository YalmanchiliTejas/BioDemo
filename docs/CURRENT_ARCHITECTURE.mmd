flowchart LR
    %% CURRENT BIODEMO ARCHITECTURE

    subgraph SOURCES["Pharmaceutical systems of record"]
        direction TB
        MES["MES / eBR"]
        HIST["Historian / SCADA"]
        LIMS["LIMS / CDS"]
        QMS["QMS"]
        CMMS["CMMS"]
        ERP["ERP / WMS"]
        SCHED["Scheduler"]
        LMS["Training / LMS"]
    end

    subgraph INTEGRATION["Integration and event ingestion"]
        direction TB
        CONNECTORS["HTTP source connectors"]
        MONITOR["Connector monitor"]
        NORMALIZER["Canonical event normalizer"]
        BUS["Event bus and durable outbox"]
    end

    subgraph THREAD["Manufacturing digital thread"]
        direction TB
        EVIDENCE["Immutable source evidence<br/>MinIO / S3"]
        DOCUMENTS["Source records and controlled documents<br/>MongoDB"]
        GRAPH["Entities, timelines, and provenance<br/>Neo4j"]
        WORKFLOW["Cases, tasks, approvals, and outbox<br/>PostgreSQL"]
        SEARCH["Optional semantic index<br/>Qdrant"]
    end

    subgraph INTELLIGENCE["Current intelligence layer"]
        direction TB
        ROUTER["Case orchestrator"]
        SPECIALISTS["Bounded specialist workflows<br/>Deterministic fallback"]
        PRIME["Prime deviation agent<br/>Optional external runtime"]
        TOOLS["Allow-listed tools<br/>SPC, anomaly detection, DOE"]
    end

    subgraph APPLICATION["Operations application"]
        direction TB
        COMMAND["Command center"]
        INVESTIGATIONS["Investigation workspace"]
        BATCHES["Batch and shift console"]
        SCIENCE["Science and quality workspace"]
        CONTROL["Agent control plane"]
        APPROVALS["Approval inbox"]
        AUDIT["Audit trail"]
    end

    subgraph ACTIONS["Governed action boundary"]
        direction TB
        POLICY["Risk and approval policy"]
        REVIEW["Human review"]
        GATEWAY["Execution gateway"]
        WRITER["Demo writer or configured<br/>source-system adapter"]
    end

    BENCHMARK["Separate deterministic factory benchmark<br/>Illustrative operating assumptions"]

    SOURCES --> CONNECTORS
    CONNECTORS --> MONITOR
    MONITOR --> NORMALIZER
    NORMALIZER --> BUS
    NORMALIZER --> EVIDENCE
    NORMALIZER --> DOCUMENTS
    NORMALIZER --> GRAPH
    NORMALIZER --> WORKFLOW
    DOCUMENTS --> SEARCH

    EVIDENCE --> ROUTER
    DOCUMENTS --> ROUTER
    GRAPH --> ROUTER
    WORKFLOW --> ROUTER
    ROUTER --> SPECIALISTS
    ROUTER --> PRIME
    SPECIALISTS --> TOOLS
    PRIME --> TOOLS

    THREAD --> APPLICATION
    SPECIALISTS --> INVESTIGATIONS
    PRIME --> INVESTIGATIONS
    INVESTIGATIONS --> POLICY
    POLICY --> REVIEW
    REVIEW -->|Approved| GATEWAY
    REVIEW -->|Rejected or revised| WORKFLOW
    GATEWAY --> WRITER
    WRITER -. "Execution acknowledgement" .-> NORMALIZER
    GATEWAY --> AUDIT

    BENCHMARK -. "Demo metrics and scenario comparison" .-> APPLICATION

    classDef source fill:#172033,stroke:#7c8da6,color:#f4f7fb;
    classDef data fill:#102a43,stroke:#39a0ed,color:#f4f7fb;
    classDef intelligence fill:#2b1d46,stroke:#9b7ede,color:#f4f7fb;
    classDef application fill:#16352f,stroke:#42c7a5,color:#f4f7fb;
    classDef governance fill:#422d13,stroke:#e5a53a,color:#f4f7fb;
    classDef caveat fill:#3b2025,stroke:#ec6674,color:#f4f7fb;

    class MES,HIST,LIMS,QMS,CMMS,ERP,SCHED,LMS source;
    class CONNECTORS,MONITOR,NORMALIZER,BUS,EVIDENCE,DOCUMENTS,GRAPH,WORKFLOW,SEARCH data;
    class ROUTER,SPECIALISTS,PRIME,TOOLS intelligence;
    class COMMAND,INVESTIGATIONS,BATCHES,SCIENCE,CONTROL,APPROVALS,AUDIT application;
    class POLICY,REVIEW,GATEWAY,WRITER governance;
    class BENCHMARK caveat;

