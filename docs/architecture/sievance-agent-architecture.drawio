            <mxGeometry as="geometry" x="1220" y="505" width="500" height="190" />
          </mxCell>
        </object>
        <object id="proposal" label="Reviewable proposal&#10;&#10;Exact target, payload, rationale, owner, required approvals, version/content hash and evidence dependencies. Prior-investigation reuse needs owner approval." tooltip="Source: backend/src/lifesci/actions.py; backend/src/workflows/investigation_review.py" sourceFiles="backend/src/lifesci/actions.py; backend/src/workflows/investigation_review.py" implementationStatus="human">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#f4effa;strokeColor=#8b6ba5;strokeWidth=1.5;">
