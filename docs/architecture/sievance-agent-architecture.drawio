        <object id="child" label="4 · Recursive child agents&#10;&#10;Native child sessions/kernel with depth and session attribution. Each investigates its scoped question, cites evidence and saves a subreport; no final-report authority." tooltip="Source: backend/src/prime_runtime/sdk_runner.mjs; backend/src/prime_runtime/bridge.py" sourceFiles="backend/src/prime_runtime/sdk_runner.mjs; backend/src/prime_runtime/bridge.py" implementationStatus="code">
