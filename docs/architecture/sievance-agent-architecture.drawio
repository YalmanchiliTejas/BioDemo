        <object id="approval" label="Approval of exact version&#10;&#10;People with required authority decide on the current content/evidence basis. Revision or stale evidence invalidates relevant approvals/queued intents." tooltip="Source: backend/src/lifesci/actions.py; backend/src/lifesci/records.py" sourceFiles="backend/src/lifesci/actions.py; backend/src/lifesci/records.py" implementationStatus="human">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#f4effa;strokeColor=#8b6ba5;strokeWidth=1.5;">
