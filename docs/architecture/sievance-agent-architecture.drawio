        <object id="prepare" label="1 · Python harness preparation&#10;&#10;Lock incident, create scoped bridge and deterministic analysis-preparation artifact. Configure shared execution budget, deadline and finalization reserve." tooltip="Source: backend/src/prime_runtime/harness.py" sourceFiles="backend/src/prime_runtime/harness.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
