        <object id="db" label="Platform persistence&#10;&#10;RecordStore supports SQLite/PostgreSQL; production configuration selects its backend. Domain revisions/events and outbox remain platform records." tooltip="Source: backend/src/lifesci/store.py" sourceFiles="backend/src/lifesci/store.py" implementationStatus="data">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf3fc;strokeColor=#5277a7;strokeWidth=1.5;">
