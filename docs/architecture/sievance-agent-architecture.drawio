        <object id="executor" label="Investigation executor service&#10;&#10;Separate cloud_backend service/project scopes. INVESTIGATION_EXECUTOR_URL + signing key and plan/permissions gate starts. No synthetic success fallback." tooltip="Source: backend/src/lifesci/investigations.py; backend/src/cloud_backend/api.py" sourceFiles="backend/src/lifesci/investigations.py; backend/src/cloud_backend/api.py" implementationStatus="conditional">
