        <mxCell id="title" value="02 · Interactive assistant execution" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=32;fontColor=#193a3d;fontFamily=Helvetica;">
          <mxGeometry as="geometry" x="60" y="35" width="1680" height="60" />
        </mxCell>
        <mxCell id="subtitle" value="Native tool loop and typed planner share authorization, operators, evidence and durable conversation records." vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=18;fontColor=#53676f;fontFamily=Helvetica;">
          <mxGeometry as="geometry" x="60" y="105" width="1680" height="60" />
        </mxCell>
        <mxCell id="legend" value="SOURCE MAP · 2026-11-07     |     TEAL: code     BLUE: state/evidence     AMBER: configuration-dependent     PURPLE: human authority" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#53676f;fontFamily=Helvetica;">
          <mxGeometry as="geometry" x="60" y="177" width="1680" height="35" />
        </mxCell>
        <object id="request" label="1 · Accept and enqueue turn&#10;&#10;Owner-controlled conversation + expected revision. Save user text, context and turn; queue work and retain mission linkage." tooltip="Source: backend/src/lifesci/process_engineering/conversation.py" sourceFiles="backend/src/lifesci/process_engineering/conversation.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="250" width="500" height="190" />
          </mxCell>
        </object>
        <object id="lease" label="2 · Claim and check current authority&#10;&#10;Worker resumes saved progress. Turn/mission fencing prevents stopped or replaced workers from publishing new results." tooltip="Source: backend/src/lifesci/process_engineering/conversation.py; backend/src/lifesci/workqueue.py" sourceFiles="backend/src/lifesci/process_engineering/conversation.py; backend/src/lifesci/workqueue.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="640" y="250" width="500" height="190" />
          </mxCell>
        </object>
        <object id="context" label="3 · Assemble bounded context&#10;&#10;Recent two exchanges, earlier-turn index, standing rules, corrections, memory index, permitted sources and case index. Source text is untrusted data." tooltip="Source: backend/src/lifesci/process_engineering/tool_loop.py; backend/src/lifesci/agent_memory.py" sourceFiles="backend/src/lifesci/process_engineering/tool_loop.py; backend/src/lifesci/agent_memory.py" implementationStatus="data">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf3fc;strokeColor=#5277a7;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="1220" y="250" width="500" height="190" />
          </mxCell>
        </object>
        <object id="choose" label="4 · Select harness&#10;&#10;ASSISTANT_LOOP=tools forces native tools; planner forces typed workflow planning. Unset: demo tenants use tools, other tenants use planner." tooltip="Source: backend/src/lifesci/process_engineering/tool_loop.py" sourceFiles="backend/src/lifesci/process_engineering/tool_loop.py" implementationStatus="conditional">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#fff6e7;strokeColor=#b17a24;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="505" width="500" height="190" />
          </mxCell>
        </object>
        <object id="native" label="5A · Native model/tool loop&#10;&#10;Gateway.converse returns answer or function calls. Host validates each call; errors are observations the model can correct." tooltip="Source: backend/src/lifesci/process_engineering/tool_loop.py; backend/src/lifesci/gateway/gateway.py" sourceFiles="backend/src/lifesci/process_engineering/tool_loop.py; backend/src/lifesci/gateway/gateway.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="640" y="505" width="500" height="190" />
          </mxCell>
        </object>
        <object id="planner" label="5B · Typed workflow planner&#10;&#10;Model returns ChatDecision + workflow. Validate node payloads/dependencies; FlowService executes registered operators in dependency order." tooltip="Source: backend/src/lifesci/process_engineering/conversation_schemas.py; backend/src/lifesci/flows.py" sourceFiles="backend/src/lifesci/process_engineering/conversation_schemas.py; backend/src/lifesci/flows.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="1220" y="505" width="500" height="190" />
          </mxCell>
        </object>
        <object id="operator" label="6 · Execute authorized operator&#10;&#10;workspace_search/read, links, similar cases, source inspection, forecasts, comparisons, simulations and proposals. Capability-filtered schemas." tooltip="Source: backend/src/lifesci/process_engineering/conversation.py; backend/src/lifesci/process_engineering/workspace.py" sourceFiles="backend/src/lifesci/process_engineering/conversation.py; backend/src/lifesci/process_engineering/workspace.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="760" width="500" height="190" />
          </mxCell>
        </object>
        <object id="checkpoint" label="7 · Save result and progress&#10;&#10;Durable artifact references, tool status, timing, issues and bounded transcript. Compaction replaces older results with reloadable pointers." tooltip="Source: backend/src/lifesci/process_engineering/tool_loop.py; backend/src/lifesci/process_engineering/conversation.py" sourceFiles="backend/src/lifesci/process_engineering/tool_loop.py; backend/src/lifesci/process_engineering/conversation.py" implementationStatus="data">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf3fc;strokeColor=#5277a7;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="640" y="760" width="500" height="190" />
          </mxCell>
        </object>
        <object id="limit" label="8 · Enforce native-loop limits&#10;&#10;10 model calls, 16 tool calls, 300 s loop budget. Final call disables tools. ask_user ends with a question; provider failure retains partial work." tooltip="Source: backend/src/lifesci/process_engineering/tool_loop.py" sourceFiles="backend/src/lifesci/process_engineering/tool_loop.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="1220" y="760" width="500" height="190" />
          </mxCell>
        </object>
        <object id="ground" label="9 · Check provenance and basis&#10;&#10;Deterministic quote/number support and source revisions. Grounding checks provenance, not causal truth or semantic correctness." tooltip="Source: backend/src/lifesci/process_engineering/grounding.py; backend/src/lifesci/process_engineering/conversation.py" sourceFiles="backend/src/lifesci/process_engineering/grounding.py; backend/src/lifesci/process_engineering/conversation.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="1015" width="500" height="190" />
          </mxCell>
        </object>
        <object id="finish" label="10 · Publish inspectable result&#10;&#10;Reply, questions, artifacts, tool steps and grounding remain visible. Completed, needs_information or agent_unavailable reflect actual outcome." tooltip="Source: backend/src/lifesci/process_engineering/conversation.py; frontend/components/process/EngineeringChat.tsx" sourceFiles="backend/src/lifesci/process_engineering/conversation.py; frontend/components/process/EngineeringChat.tsx" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
