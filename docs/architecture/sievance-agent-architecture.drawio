        <mxCell id="title" value="04 · Multi-agent investigation execution plane" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=32;fontColor=#193a3d;fontFamily=Helvetica;">
          <mxGeometry as="geometry" x="60" y="35" width="1680" height="60" />
        </mxCell>
        <mxCell id="subtitle" value="The browser stays on the platform API; the execution service receives only an authorized pinned evidence snapshot." vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=18;fontColor=#53676f;fontFamily=Helvetica;">
          <mxGeometry as="geometry" x="60" y="105" width="1680" height="60" />
        </mxCell>
        <mxCell id="legend" value="SOURCE MAP · 2026-11-07     |     TEAL: code     BLUE: state/evidence     AMBER: configuration-dependent     PURPLE: human authority" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#53676f;fontFamily=Helvetica;">
          <mxGeometry as="geometry" x="60" y="177" width="1680" height="35" />
        </mxCell>
        <object id="start" label="1 · Person presses Start&#10;&#10;Optional assistant proposal first. Check paid entitlement, person identity and propose authority on case/site. Current defaults: 30 calls / 10 min; 1 active per tenant." tooltip="Source: backend/src/lifesci/investigations.py" sourceFiles="backend/src/lifesci/investigations.py" implementationStatus="human">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#f4effa;strokeColor=#8b6ba5;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="250" width="500" height="190" />
          </mxCell>
        </object>
        <object id="snapshot" label="2 · Freeze authorized evidence&#10;&#10;Recheck access, build deterministic ZIP, SHA-256 and item/revision manifest. Maximum 64 MiB. Persist platform investigation_run + mission link." tooltip="Source: backend/src/lifesci/investigations.py" sourceFiles="backend/src/lifesci/investigations.py" implementationStatus="data">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf3fc;strokeColor=#5277a7;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="640" y="250" width="500" height="190" />
          </mxCell>
        </object>
        <object id="submit" label="3 · Service-to-service submission&#10;&#10;RS256 token, issuer/JWKS, audience and scoped executor project. Upload then idempotent job submit. Configuration missing → explicit unavailable result." tooltip="Source: backend/src/lifesci/investigations.py; backend/src/cloud_backend/auth.py" sourceFiles="backend/src/lifesci/investigations.py; backend/src/cloud_backend/auth.py" implementationStatus="conditional">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#fff6e7;strokeColor=#b17a24;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="1220" y="250" width="500" height="190" />
          </mxCell>
        </object>
        <object id="control" label="4 · Executor control plane&#10;&#10;Job API authorizes service tenant/project. PostgreSQL keeps jobs, attempts, deadlines, fences, event cursors and cancellation state." tooltip="Source: backend/src/cloud_backend/api.py; backend/src/cloud_backend/store.py" sourceFiles="backend/src/cloud_backend/api.py; backend/src/cloud_backend/store.py" implementationStatus="conditional">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#fff6e7;strokeColor=#b17a24;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="505" width="500" height="190" />
          </mxCell>
        </object>
        <object id="dispatch" label="5 · Dispatcher admission&#10;&#10;Reconcile jobs and Docker containers. Pin image digest; launch a bounded attempt; enforce deadline/cancel/fence and collect allow-listed stdout events." tooltip="Source: backend/src/cloud_backend/dispatcher.py" sourceFiles="backend/src/cloud_backend/dispatcher.py" implementationStatus="conditional">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#fff6e7;strokeColor=#b17a24;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="640" y="505" width="500" height="190" />
          </mxCell>
        </object>
        <object id="agent" label="6 · Isolated agent attempt&#10;&#10;Non-root, read-only filesystem, private tmpfs, resource caps and restricted egress proxy. No DB credentials or Docker socket. Object-specific keys/URLs." tooltip="Source: backend/src/cloud_backend/dispatcher.py; backend/src/cloud_backend/agent.py" sourceFiles="backend/src/cloud_backend/dispatcher.py; backend/src/cloud_backend/agent.py" implementationStatus="conditional">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#fff6e7;strokeColor=#b17a24;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="1220" y="505" width="500" height="190" />
          </mxCell>
        </object>
        <object id="prime" label="7 · Prime harness + lead/children&#10;&#10;Decrypt and verify input; ingest snapshot into local scoped store. Start persistent SDK/kernel + bridge, with wall-time/tool/token bounds." tooltip="Source: backend/src/cloud_backend/agent.py; backend/src/prime_runtime/harness.py" sourceFiles="backend/src/cloud_backend/agent.py; backend/src/prime_runtime/harness.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="760" width="500" height="190" />
          </mxCell>
        </object>
        <object id="progress" label="8 · Progress event stream&#10;&#10;SDK child/model metadata + bridge allocations/subreports → emitter → stdout → dispatcher → fenced job_events. Raw source/model text excluded." tooltip="Source: backend/src/prime_runtime/investigation_events.py; backend/src/cloud_backend/dispatcher.py" sourceFiles="backend/src/prime_runtime/investigation_events.py; backend/src/cloud_backend/dispatcher.py" implementationStatus="data">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf3fc;strokeColor=#5277a7;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="640" y="760" width="500" height="190" />
          </mxCell>
        </object>
        <object id="result" label="9 · Seal result&#10;&#10;Report envelope includes job run_id, input hash/version and requires_human_review. AES-GCM result stored via object-specific URL in Spaces-compatible storage." tooltip="Source: backend/src/cloud_backend/agent.py; backend/src/cloud_backend/crypto.py" sourceFiles="backend/src/cloud_backend/agent.py; backend/src/cloud_backend/crypto.py" implementationStatus="data">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf3fc;strokeColor=#5277a7;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="1220" y="760" width="500" height="190" />
          </mxCell>
        </object>
        <object id="sync" label="10 · Platform synchronizes&#10;&#10;Poll job/events/result on reads and runtime sync. Deduplicate event cursors; copy progress to platform records; cancellation/fences reject late completion." tooltip="Source: backend/src/lifesci/investigations.py; backend/src/lifesci/runtime.py" sourceFiles="backend/src/lifesci/investigations.py; backend/src/lifesci/runtime.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="1015" width="500" height="190" />
          </mxCell>
        </object>
        <object id="validate" label="11 · Validate report envelope&#10;&#10;Check expected executor job ID, input SHA and requires_human_review; retain pinned basis and flag changed/inaccessible evidence. Persist report reference." tooltip="Source: backend/src/lifesci/investigations.py" sourceFiles="backend/src/lifesci/investigations.py" implementationStatus="data">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf3fc;strokeColor=#5277a7;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="640" y="1015" width="500" height="190" />
          </mxCell>
        </object>
        <object id="report" label="12 · Await human review&#10;&#10;UI displays agent tree, progress, budget, gaps and report. Completed execution is awaiting_review; Stop cancels and retains inspectable partial history." tooltip="Source: frontend/components/process/InvestigationCard.tsx; backend/src/lifesci/investigations.py" sourceFiles="frontend/components/process/InvestigationCard.tsx; backend/src/lifesci/investigations.py" implementationStatus="human">
