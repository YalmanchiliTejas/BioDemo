          </mxCell>
        </object>
        <object id="container" label="Prime worker packaging&#10;&#10;Approved digest-pinned image needs Python harness + Node SDK bundle, native kernel/skills and provider configuration. Lambda does not automatically host this stack." tooltip="Source: backend/src/cloud_backend/dispatcher.py; backend/src/prime_runtime/sdk_runner.mjs" sourceFiles="backend/src/cloud_backend/dispatcher.py; backend/src/prime_runtime/sdk_runner.mjs" implementationStatus="conditional">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#fff6e7;strokeColor=#b17a24;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="1220" y="505" width="500" height="190" />
          </mxCell>
        </object>
        <object id="objects" label="Executor DB + object storage&#10;&#10;Jobs/events in executor Postgres. Sealed versioned input/result objects in Spaces-compatible storage; attempt keys and presigned URLs restrict container access." tooltip="Source: backend/src/cloud_backend/store.py; backend/src/cloud_backend/crypto.py" sourceFiles="backend/src/cloud_backend/store.py; backend/src/cloud_backend/crypto.py" implementationStatus="data">
