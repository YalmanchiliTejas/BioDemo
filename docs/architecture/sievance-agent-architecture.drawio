        <mxCell id="title" value="03 · Durable responsibilities and follow-up" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=32;fontColor=#193a3d;fontFamily=Helvetica;">
          <mxGeometry as="geometry" x="60" y="35" width="1680" height="60" />
        </mxCell>
        <mxCell id="subtitle" value="Waiting is persisted state; relevant events or due obligations cause bounded work, not continuous model inference." vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=18;fontColor=#53676f;fontFamily=Helvetica;">
          <mxGeometry as="geometry" x="60" y="105" width="1680" height="60" />
        </mxCell>
        <mxCell id="legend" value="SOURCE MAP · 2026-11-07     |     TEAL: code     BLUE: state/evidence     AMBER: configuration-dependent     PURPLE: human authority" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=14;fontColor=#53676f;fontFamily=Helvetica;">
          <mxGeometry as="geometry" x="60" y="177" width="1680" height="35" />
        </mxCell>
        <object id="owner" label="1 · Owner configures responsibility&#10;&#10;A person sets objective, event kinds, optional interval and finite run allowance; inference acknowledgment is required. Owner may disable, pause or stop." tooltip="Source: backend/src/lifesci/process_engineering/responsibilities.py" sourceFiles="backend/src/lifesci/process_engineering/responsibilities.py" implementationStatus="human">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#f4effa;strokeColor=#8b6ba5;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="250" width="500" height="190" />
          </mxCell>
        </object>
        <object id="state" label="2 · Mission + conversation state&#10;&#10;Persist responsibility, owner/site scope, subscriptions, obligations, lifetime runs admitted, corrections, pending decisions and unfinished work." tooltip="Source: backend/src/lifesci/missions.py; backend/src/lifesci/process_engineering/responsibilities.py" sourceFiles="backend/src/lifesci/missions.py; backend/src/lifesci/process_engineering/responsibilities.py" implementationStatus="data">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf3fc;strokeColor=#5277a7;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="640" y="250" width="500" height="190" />
          </mxCell>
        </object>
        <object id="event" label="3 · Source commit or due time&#10;&#10;Cases, evidence, batches or lab/sample events enter the record event stream. Due obligations can also trigger follow-up." tooltip="Source: backend/src/lifesci/process_engineering/responsibilities.py; backend/src/lifesci/store.py" sourceFiles="backend/src/lifesci/process_engineering/responsibilities.py; backend/src/lifesci/store.py" implementationStatus="data">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf3fc;strokeColor=#5277a7;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="1220" y="250" width="500" height="190" />
          </mxCell>
        </object>
        <object id="pump" label="4 · Runtime event pump&#10;&#10;Store commit callback + per-tenant recovery tick. Deliver subscribed events; recover queued turns, triage and investigation sync work." tooltip="Source: backend/src/lifesci/runtime.py" sourceFiles="backend/src/lifesci/runtime.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="505" width="500" height="190" />
          </mxCell>
        </object>
        <object id="schedule" label="5 · Mission scheduler&#10;&#10;InProcessScheduler is the default port. Wakeups/timers activate eligible missions. Runtime supports bounded recovery without inference while idle." tooltip="Source: backend/src/lifesci/missions.py; backend/src/lifesci/runtime.py" sourceFiles="backend/src/lifesci/missions.py; backend/src/lifesci/runtime.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="640" y="505" width="500" height="190" />
          </mxCell>
        </object>
        <object id="activation" label="6 · Fenced activation&#10;&#10;Acquire worker lease + fencing token. Load current owner authority. Paused/stopped/replaced work cannot commit as the active worker." tooltip="Source: backend/src/lifesci/missions.py; backend/src/lifesci/roles.py" sourceFiles="backend/src/lifesci/missions.py; backend/src/lifesci/roles.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="1220" y="505" width="500" height="190" />
          </mxCell>
        </object>
        <object id="coordinate" label="7 · Coordinator chooses work&#10;&#10;Run due deterministic/model obligations; delegate configured assistant follow-up. Preserve remaining work and unresolved decision state." tooltip="Source: backend/src/lifesci/runtime.py" sourceFiles="backend/src/lifesci/runtime.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="760" width="500" height="190" />
          </mxCell>
        </object>
        <object id="follow" label="8 · Follow-up admission&#10;&#10;Enabled responsibility + pending event/due work + remaining run count. Avoid colliding with active human turns; resume prior background turn on retry." tooltip="Source: backend/src/lifesci/process_engineering/responsibilities.py" sourceFiles="backend/src/lifesci/process_engineering/responsibilities.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="640" y="760" width="500" height="190" />
          </mxCell>
        </object>
        <object id="turn" label="9 · Reuse assistant harness&#10;&#10;Create or resume a bounded background conversation turn under delegated owner permissions. Same discovery, tools, grounding and artifacts." tooltip="Source: backend/src/lifesci/process_engineering/responsibilities.py; backend/src/lifesci/process_engineering/conversation.py" sourceFiles="backend/src/lifesci/process_engineering/responsibilities.py; backend/src/lifesci/process_engineering/conversation.py" implementationStatus="code">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf7f4;strokeColor=#26756b;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="1220" y="760" width="500" height="190" />
          </mxCell>
        </object>
        <object id="commit" label="10 · Durable checkpoint&#10;&#10;Consume event IDs only after a durable turn outcome. Update obligation state, progress, next wake and remaining work; release activation." tooltip="Source: backend/src/lifesci/missions.py; backend/src/lifesci/runtime.py" sourceFiles="backend/src/lifesci/missions.py; backend/src/lifesci/runtime.py" implementationStatus="data">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf3fc;strokeColor=#5277a7;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="60" y="1015" width="500" height="190" />
          </mxCell>
        </object>
        <object id="wait" label="11 · Explicit waiting/control&#10;&#10;In-app drafts and decision requests. No autonomous manufacturing action. Run-count limit is not a dollar cap; unavailable provider billing stays unknown." tooltip="Source: backend/src/lifesci/process_engineering/responsibilities.py" sourceFiles="backend/src/lifesci/process_engineering/responsibilities.py" implementationStatus="human">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#f4effa;strokeColor=#8b6ba5;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="640" y="1015" width="500" height="190" />
          </mxCell>
        </object>
        <object id="temporal" label="Optional Temporal adapter&#10;&#10;TemporalScheduler + deterministic workflows/activities implement the scheduler port when explicitly attached. Domain records stay outside workflow history." tooltip="Source: backend/src/lifesci/orchestration/temporal.py; backend/src/lifesci/orchestration/temporal_workflows.py" sourceFiles="backend/src/lifesci/orchestration/temporal.py; backend/src/lifesci/orchestration/temporal_workflows.py" implementationStatus="conditional">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#fff6e7;strokeColor=#b17a24;strokeWidth=1.5;">
            <mxGeometry as="geometry" x="1220" y="1015" width="500" height="190" />
          </mxCell>
        </object>
        <mxCell id="e0" parent="1" edge="1" source="owner" target="state" value="configure" style="edgeStyle=none;noEdgeStyle=1;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#677e86;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;whiteSpace=wrap;labelWidth=70;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
