  <diagram id="page-3" name="03 · Durable responsibilities and follow-up">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" guides="1" connect="1" arrows="1">
      <root>
        <mxCell id="0" />
