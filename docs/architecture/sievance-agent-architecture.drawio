          </mxCell>
        </object>
        <object id="intent" label="Approved action intent&#10;&#10;Separate durable object; approval is not execution. Preflight revalidates authority, record ownership and evidence immediately before dispatch." tooltip="Source: backend/src/lifesci/actions.py; backend/src/lifesci/ownership.py" sourceFiles="backend/src/lifesci/actions.py; backend/src/lifesci/ownership.py" implementationStatus="data">
          <mxCell vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=18;fontFamily=Helvetica;fontSize=15;fontColor=#193a3d;fillColor=#edf3fc;strokeColor=#5277a7;strokeWidth=1.5;">
