        <object id="model" label="Interactive model providers&#10;&#10;Gateway adapters select configured OpenAI/Anthropic/Modal providers and qualified routes. Development unqualified fallback is explicit and flagged." tooltip="Source: backend/src/lifesci/gateway/providers.py; backend/src/lifesci/gateway/router.py" sourceFiles="backend/src/lifesci/gateway/providers.py; backend/src/lifesci/gateway/router.py" implementationStatus="conditional">
