        <object id="derive" label="Registered scientific work&#10;&#10;Forecasts, comparisons and typed numerical models save inputs, assumptions and derived artifacts. Model-generated claims remain interpretations." tooltip="Source: backend/src/lifesci/process_engineering/conversation.py; backend/src/lifesci/science.py; backend/src/lifesci/lyophilization/service.py" sourceFiles="backend/src/lifesci/process_engineering/conversation.py; backend/src/lifesci/science.py; backend/src/lifesci/lyophilization/service.py" implementationStatus="code">
