        <object id="sdk" label="2 · Node SDK session&#10;&#10;sdk_runner.mjs loads bundled Prime SDK, model/provider configuration, persisted session and ipython tool. Context compaction policy passes to children." tooltip="Source: backend/src/prime_runtime/sdk_runner.mjs; backend/src/prime_runtime/compaction_policy.mjs" sourceFiles="backend/src/prime_runtime/sdk_runner.mjs; backend/src/prime_runtime/compaction_policy.mjs" implementationStatus="code">
