        </object>
        <object id="system" label="Owning system of record&#10;&#10;MES/LIMS/QMS or another explicitly assigned record owner remains authoritative. Unknown delivery is reconciled before claiming success or retrying." tooltip="Source: backend/src/lifesci/ownership.py; backend/src/lifesci/actions.py" sourceFiles="backend/src/lifesci/ownership.py; backend/src/lifesci/actions.py" implementationStatus="data">
