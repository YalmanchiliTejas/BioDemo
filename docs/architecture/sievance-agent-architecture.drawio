          </mxCell>
        </object>
        <object id="dispatch" label="Configured authorized writer&#10;&#10;ActionService dispatches through a Writer integration, with idempotency and receipt reconciliation. Do not assume every target has an enabled writer." tooltip="Source: backend/src/lifesci/actions.py; backend/src/lifesci/integrations.py" sourceFiles="backend/src/lifesci/actions.py; backend/src/lifesci/integrations.py" implementationStatus="conditional">
