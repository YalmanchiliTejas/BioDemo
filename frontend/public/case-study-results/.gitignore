!physics-benchmark/*.csv
!physics-benchmark/*.md
!combined-physics/
!combined-physics/*.json
!combined-physics/*.md

# Recorded literature results linked from the public case studies.
!fermentation.json

# Actual, sanitized live-app demo captures and the reviewed presentation.
!live-app/
!live-app/*.json
!live-app/*.md
!live-app/*.mp4
!live-app/*.png

# Compact manufacturing workflow scores; private runtime traces excluded.
!workflows/
!workflows/*.json
!workflows/*.md

!agent-accuracy/
!agent-accuracy/*.json
!agent-accuracy/*.md
!agent-accuracy/*.mp4

# Reviewed freeze-drying figures, numerical evidence and reproducible model code.
!freeze-drying/
